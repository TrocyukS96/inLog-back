APP_NAME=inLog API
APP_VERSION=0.1.0
DEBUG=true

HOST=0.0.0.0
PORT=8000

# JWT
SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend URL for email confirmation links
FRONTEND_URL=http://localhost:5173
EMAIL_FROM=InLog <onboarding@resend.dev>

# Resend (recommended for Render/production — HTTP API, SMTP ports are blocked)
# https://resend.com — free tier: 100 emails/day
# RESEND_API_KEY=re_xxxxxxxx
# After domain verification use: EMAIL_FROM=InLog <noreply@data-factory.ru>

# Bootstrap super admin on startup (optional)
# SUPER_ADMIN_EMAIL=admin@example.com

# SMTP (works locally; Render blocks outbound port 587)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=true
# SMTP_TIMEOUT=10

# Supabase → Connect → Session pooler (port 5432)
# Direct connection (db.*.supabase.co) is IPv6-only and fails on many networks.
# Use pooler URL with username postgres.YOUR_PROJECT_REF:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
