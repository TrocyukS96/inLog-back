APP_NAME=inLog API
APP_VERSION=0.1.0
DEBUG=true

HOST=0.0.0.0
PORT=8000

# JWT
SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend URL for email confirmation links
FRONTEND_URL=http://localhost:5173
EMAIL_FROM=noreply@inlog.local
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=24
EMAIL_CHANGE_EXPIRE_HOURS=24

# SMTP (optional — without SMTP links are logged to the server console)
# Note: Render and many cloud hosts block outbound SMTP port 587.
# Use a transactional email API (Resend, SendGrid) or run SMTP from a worker.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=true
# SMTP_TIMEOUT=10

# Supabase → Connect → Session pooler (port 5432)
# Direct connection (db.*.supabase.co) is IPv6-only and fails on many networks.
# Use pooler URL with username postgres.YOUR_PROJECT_REF:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
